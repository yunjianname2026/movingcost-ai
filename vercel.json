{
  "cleanUrls": true,
  "functions": {
    "api/send-report.js": {
      "maxDuration": 800
    }
  },
  "redirects": [
    { "source": "/startup-lab", "destination": "/pathways/startup-lab", "permanent": true },
    { "source": "/startup-lab-handbook", "destination": "/pathways/startup-lab/handbook", "permanent": true },
    { "source": "/startup-lab-apply", "destination": "/pathways/startup-lab/apply", "permanent": true }
  ],
  "rewrites": [
    { "source": "/blog/nyc-to-lisbon", "destination": "/blog/nyc-to-lisbon.html" },
    { "source": "/planner", "destination": "/planner.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/thank-you", "destination": "/thank-you.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*\\.jpg|.*\\.png|.*\\.svg|.*\\.ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
